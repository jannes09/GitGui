{
  "name": "gitgui",
  "version": "0.1.0",
  "private": true,
  "description": "A GitKraken-style Git client",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "smoke": "node scripts/dev.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
