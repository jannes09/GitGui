{
  "name": "gitgui",
  "version": "0.3.5",
  "private": true,
  "description": "A GitKraken-style Git client",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "smoke": "node scripts/dev.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "dist": "npm run build && node scripts/build-info.cjs && electron-builder --win portable",
    "dist:installer": "npm run build && node scripts/build-info.cjs && electron-builder --win nsis",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.gitgui.app",
    "productName": "GitGui",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "GitGui-${version}-${arch}.${ext}",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "GitGui-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false
    }
  }
}
